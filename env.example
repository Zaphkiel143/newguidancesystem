DATABASE_URL=
DIRECT_URL=
NLP_SERVICE_URL=

# AI reply generation - any OpenAI-compatible endpoint (free Gemini tier here)
# Fill-in instructions: see AI-ENV-SETUP.md in the project root.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=your-api-key-here
AI_MODEL=gemini-3.6-flash

# Guidance Associate accounts (there is no Super Admin)
# COUNSELOR_EMAILS: school emails that become Guidance Associates on first sign-in
#   (sets up the very first one; later ones arrive by handover in My Account).
# GCO_OFFICE_EMAIL: the guidance office's own STI mailbox. If a Guidance Associate
#   leaves without handing over, the claim code for the new one is sent here.
COUNSELOR_EMAILS=
GCO_OFFICE_EMAIL=
