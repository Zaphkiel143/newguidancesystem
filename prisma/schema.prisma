// Database schema (Prisma)

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id           String   @id @default(uuid())
  date         DateTime
  time         String
  studentName  String?  // Optional field if counseling a specific student
  status       String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  
  // New polished fields for the counselor
  appointmentType String? // e.g., Academic, Personal, Career Guidance
  notes           String? @db.Text
  requirements    String[] // Array of strings for checklists (Prisma supports this natively in PostgreSQL)

  // Who made the booking (student, faculty, or a parent booking for their child)
  bookedByName    String?
  bookedByRole    String?
  bookedByEmail   String?
  bookedByPhone   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model BlockedSlot {
  id          String   @id @default(uuid())
  counselorId String
  date        DateTime // Keep this matching the type used in Appointment
  time        String   // one hourly slot start, e.g. "9:00 AM"
  // Why the Guidance Associate is unavailable (e.g. "Meeting")
  reason      String?
  groupId     String?
  createdAt   DateTime @default(now())
}

model CareerPlan {
  id          String   @id @default(uuid())
  studentName String
  studentId   String
  grade       String

  // One entry per step in app/config/careerSteps.ts, in order
  stepDates   String[]

  // Free-text record of completed activities, one entry per step (same order as stepDates)
  stepNotes   String[] @default([])
  facilitator String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupGuidanceProgram {
  id           String   @id @default(uuid())
  title        String
  gradeLevel   String
  date         DateTime
  time         String
  participants Int      @default(0)

  attendees    String[] @default([])
  outcomes     String?  @db.Text

  createdAt    DateTime @default(now())
}

enum UserRole {
  COUNSELOR
  FACULTY
  PARENT
  STUDENT
}

model User {
  id           String   @id @default(uuid())
  // School email (students, faculty, guidance)
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  name         String
  role         UserRole
  // ACTIVE can use the system
  status       String   @default("ACTIVE")
  // Optional profile photo (validated image bytes, see lib/image.ts)
  avatarData   Bytes?
  avatarType   String?
  // Authenticator app sign-in (Microsoft/Google Authenticator), optional
  totpSecret   String?
  totpPending  String?
  totpLastStep Int?     // last code step used, so a code can't be reused
  totpEnabledAt DateTime?
  // When this person agreed to the privacy notice (Data Privacy Act, RA 10173)
  privacyAcceptedAt DateTime?

  sessions      Session[]
  notifications Notification[]
  childLinks    ParentChildLink[]

  createdAt    DateTime @default(now())
}

model Session {
  token     String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Referral {
  id            String   @id @default(uuid())
  studentName   String
  referrerName  String
  referrerRole  String   // Student, Faculty, Parent
  concernType   String   // e.g. Academic, Behavioral, Career/College Planning
  priority      String   @default("Normal") // Low, Normal, High, Urgent
  description   String   @db.Text
  status        String   @default("OPEN") // OPEN, IN_PROGRESS, CLOSED
  notes         String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Document {
  id           String   @id @default(uuid())
  uploaderName String
  uploaderRole String
  fileName     String
  fileType     String
  fileSize     Int
  data         Bytes

  // For documents students submit to their Individual Inventory record
  studentName  String?
  category     String?

  // Every upload is checked by the Guidance Associate before it counts
  reviewStatus String    @default("PENDING")
  reviewNote   String?
  reviewedAt   DateTime?

  createdAt    DateTime @default(now())
}

model Conversation {
  id              String   @id @default(uuid())
  participantName String   // the non-counselor party, e.g. "Nhel Belarmino"
  participantRole String   // Student, Faculty, Parent

  messages        Message[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderRole     String   // Counselor, Student, Faculty, Parent
  senderName     String
  content        String   @db.Text
  readAt         DateTime?

  createdAt      DateTime @default(now())
}

// One row per chat with E-Gabay
model AiConversation {
  id          String    @id @default(uuid())
  studentName String

  messages    AiMessage[]

  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([studentName, endedAt])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id])

  role           String   // "user" or "assistant"
  content        String   @db.Text
  // For E-Gabay's replies: the topic it recognised ("fallback" = not understood)
  intent         String?
  // Set when the student sent the unanswered question to the guidance office
  forwardedAt    DateTime?

  createdAt      DateTime @default(now())
}

// Individual Inventory

model StudentProfile {
  id                 String   @id @default(uuid())
  studentId          String   @unique
  name               String   @unique // records elsewhere are linked by name
  department         String   // "Senior High School" or "Tertiary" (older records may say "College")
  gradeSection       String   // display label, "<yearLevel> - <section>"
  yearLevel          String?  // "Grade 11", "Grade 12", "1st Year" ... "4th Year"
  section            String?
  strandOrProgram    String?  // SHS strand or tertiary course
  email              String?
  phone              String?
  birthDate          String?
  address            String?
  guardianName       String?
  guardianContact    String?
  parentName         String?  // the parent account linked to this student
  familyBackground   String?  @db.Text
  educationalHistory String?  @db.Text
  counselorNotes     String?  @db.Text

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Information Service

model Announcement {
  id          String   @id @default(uuid())
  title       String
  body        String   @db.Text
  category    String   // e.g. Seminar, Mental Health, Career, Reminder
  audience    String   @default("All") // All, Students, Faculty, Parents
  isPublished Boolean  @default(true)
  // Optional link to a post on the school's Facebook page, embedded on request
  facebookUrl String?
  // Optional photo/poster shown with the announcement
  imageData   Bytes?
  imageType   String?

  views       AnnouncementView[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnnouncementView {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  viewerName     String
  viewerRole     String
  viewedAt       DateTime     @default(now())

  @@unique([announcementId, viewerName, viewerRole])
}

// Events

model Event {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  date        DateTime
  time        String
  location    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Group Guidance: needs assessment

model NeedsAssessment {
  id         String   @id @default(uuid())
  title      String
  gradeLevel String   @default("All") // "All" or a grade level from app/config/gradeLevels.ts
  topics     String[]
  isOpen     Boolean  @default(true)

  responses  NeedsAssessmentResponse[]

  createdAt  DateTime @default(now())
}

model NeedsAssessmentResponse {
  id             String          @id @default(uuid())
  assessmentId   String
  assessment     NeedsAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentName    String
  selectedTopics String[]
  comment        String?         @db.Text

  createdAt      DateTime        @default(now())

  @@unique([assessmentId, studentName])
}

// Email notifications

// Every notification the system tries to send
model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String   @db.Text
  status    String   // SENT, LOGGED (no SMTP configured), FAILED
  error     String?

  createdAt DateTime @default(now())
}

// Sign-in with a school email code

// One-time 6-digit codes sent to a school email
model LoginCode {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?

  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}


// Parent / guardian accounts

// A parent asks to be linked to a child by the child's student ID number
model ParentChildLink {
  id               String    @id @default(uuid())
  parentId         String
  parent           User      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentIdNumber  String
  childName        String
  relationship     String    // Mother, Father, Guardian, ...
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  // Set when approved: the inventory record this link points
  studentProfileId String?
  note             String?
  reviewedAt       DateTime?

  createdAt        DateTime  @default(now())

  @@unique([parentId, studentIdNumber])
}

// In-app notifications (bell in the top bar)

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?   // page to open when clicked
  readAt    DateTime?

  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Photos attached by the Guidance Associate

// Photos attached to a Daily Log session or a group guidance session
model Attachment {
  id        String   @id @default(uuid())
  kind      String
  refId     String
  fileName  String
  fileType  String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([kind, refId])
}

// Anti-spam

// One row per limited action
model RateEvent {
  id        String   @id @default(uuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Approve sign-in from your phone

// A sign-in waiting for approval from a device where the person is already signed
model LoginRequest {
  id          String    @id @default(uuid())
  userId      String
  number      Int       // the number shown on the browser asking to sign in
  choices     Int[]     // three numbers shown on the phone, one of them correct
  secretHash  String    // proves the polling browser is the one that asked
  status      String    @default("PENDING") // PENDING, APPROVED, DENIED, USED
  device      String?   // short description of the browser asking to sign in
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId, status])
}

// Browser push subscriptions for sign-in approval notifications
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Confidentiality: who looked at which student's records

// One row each time someone opens a student's Individual Inventory record
model RecordAccess {
  id          String   @id @default(uuid())
  viewerName  String
  viewerRole  String   // Counselor, Parent, ...
  studentName String
  action      String   // e.g. "Viewed profile", "Opened document: Medical certificate"
  createdAt   DateTime @default(now())

  @@index([studentName, createdAt])
}

// Career Guidance: Career Planning Form (tertiary)

// One form per tertiary student (first-year students and transferees)
model CollegeCareerForm {
  id          String    @id @default(uuid())
  studentName String    @unique // linked to StudentProfile.name, like other records
  answers     Json
  submittedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Counselor-editable dropdown option lists
model OptionList {
  id        String       @id @default(uuid())
  listKey   String       @unique
  label     String
  // Set only for hierarchical lists (e.g. appointment reasons, scoped per category)
  parentKey String?
  items     OptionItem[]

  updatedAt DateTime     @updatedAt
}

model OptionItem {
  id             String     @id @default(uuid())
  listId         String
  list           OptionList @relation(fields: [listId], references: [id], onDelete: Cascade)

  // Stable identifier for items code depends on (e.g. "SHS")
  itemKey        String?
  // For hierarchical lists: which parent-list item (by its itemKey) this item belongs
  parentItemKey  String?
  label          String
  sortOrder      Int
  // Protected items can be relabeled and reordered, but not deleted
  isProtected    Boolean    @default(false)

  createdAt      DateTime   @default(now())

  @@index([listId, sortOrder])
}

// System-wide activity log, counselor/associate only
model ActivityLog {
  id          String   @id @default(uuid())
  actorName   String
  actorRole   String   // roleLabel snapshot, e.g. "Counselor", "Student"
  actorUserId String?
  action      String   // short phrase, e.g. "Booked an appointment"
  model       String   // Prisma model mutated, e.g. "Appointment"
  recordId    String?
  detail      String?  @db.Text

  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorRole, createdAt])
}
